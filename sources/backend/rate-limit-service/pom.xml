<?xml version="1.0" encoding="UTF-8"?>
<!--
   Traceability Tags: [ARC-000]
   Description: Maven descriptor for user-service module of social-scheduler
project.
   This file defines parent relationship, dependencies, build plugins, and
configuration for Spring Boot application.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<!-- Model version for Maven POM. -->
	<modelVersion>4.0.0</modelVersion>

	<!-- Traceability Tag: [ARC-000] -->
	<parent>
		<groupId>org.nlh4j.socialscheduler</groupId>
		<artifactId>social-scheduler</artifactId>
		<version>1.0.0</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>rate-limit-service</artifactId>
	<packaging>jar</packaging>

	<name>rate-limit-service</name>
	<description>Rate limiting service for social-scheduler using Redis token
		bucket</description>

	<dependencies>
		<!-- Spring Boot Web layer – provides RESTful endpoints and HTTP
		handling -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- Spring Boot Data Redis (Lettuce) – integrates Redis as a caching
		and rate‑limit store -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>

		<!-- Spring Boot Validation – enforces request payload contracts using
		Jakarta Validation -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- Spring Boot Actuator – exposes health, metrics, and info endpoints
		for monitoring -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- Flyway Core – database migration framework -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>

		<!-- Flyway PostgreSQL – specific support for PostgreSQL dialect -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<!-- PostgreSQL JDBC Driver – required for Flyway and runtime JDBC
		access -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
		</dependency>

		<!-- Bucket4j Core – token‑bucket rate‑limit algorithm implementation -->
		<dependency>
			<groupId>com.bucket4j</groupId>
			<artifactId>bucket4j-core</artifactId>
		</dependency>

		<!-- Bucket4j Redis integration – enables distributed token bucket
		storage via Lettuce -->
		<dependency>
			<groupId>com.bucket4j</groupId>
			<artifactId>bucket4j-redis</artifactId>
		</dependency>

		<!-- Lombok – reduces boilerplate code (getters, setters, builders,
		etc.) -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<scope>provided</scope>
		</dependency>

		<!-- Springdoc OpenAPI UI – generates interactive API documentation
		(Swagger UI) -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
		</dependency>

		<!-- Test dependencies – Spring Boot test utilities and JUnit support -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Spring Boot Maven Plugin – packages the application as an
			executable JAR -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<!-- Fully qualified main class for the rate‑limit service -->
					<mainClass>
						org.nlh4j.socialscheduler.ratelimitservice.RateLimitServiceApplication</mainClass>
					<layout>JAR</layout>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>repackage</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- Flyway Maven Plugin – executes database migrations during the
			Maven lifecycle -->
			<plugin>
				<groupId>org.flywaydb</groupId>
				<artifactId>flyway-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>