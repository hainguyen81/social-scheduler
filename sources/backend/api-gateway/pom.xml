<?xml version="1.0" encoding="UTF-8"?>
<!--
   Traceability Tags: [ARC-000]
   Description: Maven descriptor for user-service module of social-scheduler
project.
   This file defines parent relationship, dependencies, build plugins, and
configuration for Spring Boot application.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<!-- Model version for Maven POM. -->
	<modelVersion>4.0.0</modelVersion>

	<!-- Parent pom reference for the social-scheduler enterprise suite -->
	<parent>
		<groupId>org.nlh4j.socialscheduler</groupId>
		<artifactId>social-scheduler</artifactId>
		<version>1.0.0</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<!-- This module's artifact definition -->
	<artifactId>api-gateway</artifactId>
	<packaging>jar</packaging>

	<name>api-gateway</name>
	<description>API Gateway for social-scheduler project</description>

	<!-- Dependency management for AI service, observability, and data access -->
	<dependencies>
		<!-- Spring Boot Web & Reactive (WebClient for OpenAI) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webflux</artifactId>
		</dependency>

		<!-- JPA & Validation -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- Actuator for observability -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- PostgreSQL JDBC driver -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
		</dependency>

		<!-- Flyway database migration -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<!-- OpenAI Java SDK for AI content generation -->
		<dependency>
			<groupId>com.openai</groupId>
			<artifactId>openai-java</artifactId>
		</dependency>

		<!-- Caffeine caching for performance -->
		<dependency>
			<groupId>com.github.ben-manes.caffeine</groupId>
			<artifactId>caffeine</artifactId>
		</dependency>

		<!-- Springdoc OpenAPI UI for API documentation -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
		</dependency>

		<!-- Resilience4j for circuit breaker, retry, bulkhead -->
		<dependency>
			<groupId>io.github.resilience4j</groupId>
			<artifactId>resilience4j-spring-boot3-starter</artifactId>
		</dependency>

		<!-- Lombok for boilerplate reduction -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<scope>provided</scope>
		</dependency>

		<!-- Test utilities -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<!-- Build configuration: packaging, plugins, and Flyway migration -->
	<build>
		<plugins>
			<!-- Spring Boot Maven plugin for packaging and execution -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<version>${spring-boot.version}</version>
				<configuration>
					<!-- Fully qualified main class for the service -->
					<mainClass>
						org.nlh4j.socialscheduler.aiservice.AiServiceApplication</mainClass>
					<layout>JAR</layout>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>repackage</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- Flyway Maven plugin for schema migrations -->
			<plugin>
				<groupId>org.flywaydb</groupId>
				<artifactId>flyway-maven-plugin</artifactId>
				<version>${flyway.version}</version>
				<configuration>
					<!-- Adjust connection details as per environment
					(Docker/K8s) -->
					<url>jdbc:postgresql://localhost:5432/socialscheduler</url>
					<user>socialscheduler</user>
					<password>secret</password>
				</configuration>
				<executions>
					<execution>
						<id>migrate</id>
						<phase>validate</phase>
						<goals>
							<goal>migrate</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>